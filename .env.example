# Copia este archivo como .env.local y completa los datos de tu cuenta de EmailJS
# (https://dashboard.emailjs.com). Sin estos datos el envío de correos queda simulado.
# Después de cambiarlo, reinicia "npm run dev".

NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_CONTACTO=template_contacto
NEXT_PUBLIC_EMAILJS_TEMPLATE_RECUPERAR=template_recuperar
NEXT_PUBLIC_EMAILJS_TEMPLATE_BOLETA=template_boleta

# Correo de la tienda que recibe los mensajes del formulario de Contacto
NEXT_PUBLIC_CORREO_TIENDA=contacto@cyd.cl
